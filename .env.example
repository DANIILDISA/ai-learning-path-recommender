# Скопируйте этот файл в .env и подставьте свои значения.
# .env не попадает в git и не входит в поставку заказчику.

# --- Российская группа: GigaChat ---
# Ключ авторизации из личного кабинета GigaChat API.
GIGACHAT_CREDENTIALS=
# Обычно GIGACHAT_API_PERS для физлиц, GIGACHAT_API_CORP для организаций.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Зарубежная группа: OpenRouter ---
OPENROUTER_API_KEY=

# --- Локальная группа ---
# Ключ не нужен: адаптер обращается к OpenAI-совместимому эндпоинту
# локального сервера (Ollama, LM Studio, llama.cpp). Адрес и модель
# задаются в config.yaml, разделе llm.groups.local.
